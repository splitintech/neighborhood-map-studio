+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { build } from 'esbuild';
+import { readFile } from 'node:fs/promises';
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+const result = await build({ entryPoints: ['../../rental-vendors/lib/studio-layers.ts'], bundle: true, write: false, platform: 'node', format: 'cjs' });
+const module = { exports: {} };
+new Function('require', 'module', 'exports', result.outputFiles[0].text)(require, module, module.exports);
+const { mapStudioFeatureEnabled, mapStudioPublicConfig, canonicalBusinessesFromItems, loadPublicStudioLayers } = module.exports;
+
+test('host flags default off and opt in only the named pilot', () => {
+  assert.equal(mapStudioFeatureEnabled(undefined, 'san-francisco-mission'), false);
+  assert.equal(mapStudioFeatureEnabled({}, 'san-francisco-mission'), false);
+  const env = { PUBLIC_MAP_STUDIO_SAN_FRANCISCO_MISSION: 'true' };
+  assert.equal(mapStudioFeatureEnabled(env, 'san-francisco-mission'), true);
+  assert.equal(mapStudioFeatureEnabled(env, 'boston-back-bay'), false);
+  assert.deepEqual(mapStudioPublicConfig({ SUPABASE_SERVICE_ROLE_KEY: 'never-public' }), { supabaseOrigin: '', publicAnonKey: '' });
+});
+test('canonical adapter preserves source identity and never fabricates coordinates', () => {
+  assert.deepEqual(canonicalBusinessesFromItems([{ id: 'a', title: 'Source name' }]), [{ id: 'a', name: 'Source name' }]);
+  assert.deepEqual(canonicalBusinessesFromItems([{ id: 'a', title: 'Source name', location: { lat: 1, lng: 2 } }])[0].location, { lat: 1, lng: 2 });
+});
+test('disabled host never starts a request', async () => {
+  let calls = 0;
+  assert.equal(await loadPublicStudioLayers({ mapKey: 'san-francisco-mission', items: [], fetcher: () => { calls++; } }), undefined);
+  assert.equal(calls, 0);
+});
+test('optional loading does not await, replace, or gate street readiness', async () => {
+  const source = await readFile('../../rental-vendors/lib/discovery-map.ts', 'utf8');
+  assert.ok(source.includes('void loadPublicStudioLayers('));
+  assert.ok(!source.includes('await loadPublicStudioLayers('));
+  assert.ok(source.includes('const studioIsCurrent = () => isCurrent() && map === studioMap;'));
+  assert.ok(source.includes('await streets.whenReady();'));
+  assert.ok(source.includes('suppressedStudioBusinesses.clear();'));
+  assert.ok(source.includes('getItems: () => visible'));
+  // Existing selection/history/consent/provider operations remain the owners.
+  assert.ok(source.includes('selectItem(businessId, true)'));
+  assert.ok(source.includes('createLeafletMapAdapter)(map)'));
+  assert.ok(source.includes('cleanups.push(navigationOwner.subscribe(readURL))'));
+  assert.ok(source.includes('cleanups.push(consent.subscribe('));
+});
