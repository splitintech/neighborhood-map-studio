diff --git a/rental-vendors/lib/studio-layers.ts b/rental-vendors/lib/studio-layers.ts
new file mode 100644
index 0000000000000000000000000000000000000000..39174eb1f89780f4af669d0205f58ac510334bed
--- /dev/null
+++ b/rental-vendors/lib/studio-layers.ts
@@ -0,0 +1,69 @@
+import { attachPublishedLayers, type PublishedLayerMount, type PublicLayerFetcher } from '../../packages/discovery-map/public-layers';
+import type { CanonicalBusiness } from '../../packages/discovery-map/studio/contracts';
+import type { DiscoveryMapItem } from './discovery-map';
+
+export interface PublicStudioOptions {
+  mapKey: string; enabled?: boolean; supabaseOrigin?: string; publicAnonKey?: string;
+  map: any; L: any; items: readonly DiscoveryMapItem[];
+  onSelect?: (layer: any, business?: CanonicalBusiness) => void;
+  selectBusiness?: (businessId: string) => void;
+  onMove?: (layer: any, position: readonly [number, number]) => void;
+  editable?: boolean; fetcher?: PublicLayerFetcher;
+  isCurrent?: () => boolean;
+  getItems?: () => readonly DiscoveryMapItem[];
+  setBusinessSuppressed?: (businessId: string, suppressed: boolean) => void;
+}
+
+/** Public pages pass only canonical source cards into the renderer. */
+export function canonicalBusinessesFromItems(items: readonly DiscoveryMapItem[]): CanonicalBusiness[] {
+  return items.map(item => ({
+    id: item.id,
+    name: item.title,
+    ...(item.domain ? { category: item.domain } : {}),
+    ...(item.location ? { location: { lat: item.location.lat, lng: item.location.lng, ...(item.location.precisionNote ? { precisionNote: item.location.precisionNote } : {}) } } : {}),
+  }));
+}
+
+/** Every map is off by default; the env flag is an explicit per-map opt-in. */
+export function mapStudioFeatureEnabled(env: Record<string, unknown> | undefined, mapKey: string): boolean {
+  if (!env) return false;
+  const suffix = mapKey.replace(/[^a-z0-9]+/gi, '_').toUpperCase();
+  const value = env[`PUBLIC_MAP_STUDIO_${suffix}`];
+  return value === true || value === 'true';
+}
+
+/** Browser-safe external projection configuration. Never read the service key here. */
+export function mapStudioPublicConfig(env: Record<string, unknown> | undefined): { supabaseOrigin: string; publicAnonKey: string } {
+  if (!env) return { supabaseOrigin: '', publicAnonKey: '' };
+  const origin = env.PUBLIC_MAP_STUDIO_SUPABASE_URL ?? env.PUBLIC_SUPABASE_URL ?? '';
+  const key = env.PUBLIC_MAP_STUDIO_SUPABASE_ANON_KEY ?? env.PUBLIC_SUPABASE_ANON_KEY ?? '';
+  return { supabaseOrigin: typeof origin === 'string' ? origin : '', publicAnonKey: typeof key === 'string' ? key : '' };
+}
+
+export type PublicStudioLayerMount = PublishedLayerMount & { updateBusinesses?(businesses: readonly CanonicalBusiness[]): void };
+export { resolvePublicPilotMapKey } from '../../packages/discovery-map/public-layers';
+
+/** Fetches only the immutable Supabase projection after map consent is open. */
+export async function loadPublicStudioLayers(options: PublicStudioOptions): Promise<PublicStudioLayerMount | undefined> {
+  if (!options.enabled || !options.supabaseOrigin || !options.publicAnonKey) return;
+  const businesses = canonicalBusinessesFromItems(options.items);
+  return attachPublishedLayers({
+    mapKey: options.mapKey,
+    enabled: options.enabled === true,
+    supabaseOrigin: options.supabaseOrigin,
+    publicAnonKey: options.publicAnonKey,
+    L: options.L,
+    map: options.map,
+    businesses,
+    fetcher: options.fetcher,
+    isCurrent: options.isCurrent,
+    getBusinesses: options.getItems ? () => canonicalBusinessesFromItems(options.getItems!()) : undefined,
+    setBusinessSuppressed: options.setBusinessSuppressed || (() => undefined),
+    selectBusiness: businessId => {
+      if (options.selectBusiness) options.selectBusiness(businessId);
+      else options.onSelect?.({ kind: 'business', businessId });
+    },
+  });
+}
+
+export { attachPublishedLayers } from '../../packages/discovery-map/public-layers';
